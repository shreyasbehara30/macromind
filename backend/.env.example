# Copy to .env and fill in. .env is gitignored; never commit real values.

# LLM Settings
GROQ_API_KEY=
# Groq retires model IDs without notice; keep the working ID here.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
LLM_PROVIDER_PRIMARY=groq
LLM_PROVIDER_FALLBACK=groq
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen:4b

# Market Data API Keys
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
COINGECKO_API_KEY=
NSE_SESSION_REFRESH_INTERVAL=900
FINNHUB_WEBSOCKET_ENABLED=true
ANOMALY_THRESHOLD_PERCENT=1.5
ANOMALY_WINDOW_MINUTES=5
NEWS_POLL_INTERVAL_HIGH_PRIORITY=300

# Database and Cache
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security
FRONTEND_URL=http://localhost:3000
